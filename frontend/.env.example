# Vite env vars must be prefixed with VITE_ and are baked in at build time.
VITE_BACKEND_URL=http://localhost:5000

# WhatsApp support button — full international format, no leading + or
# spaces (e.g. 2348012345678). Leave unset to hide the button.
VITE_WHATSAPP_NUMBER=

# Google Sign-In (optional, free) — see README's "Google Login" section.
# Leave empty to hide the "Continue with Google" button entirely.
VITE_GOOGLE_CLIENT_ID=
