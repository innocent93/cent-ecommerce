# Vite env vars must be prefixed with VITE_ and are baked in at build time.
VITE_BACKEND_URL=http://localhost:5000

# Optional — enables "Continue with Google". Same GOOGLE_CLIENT_ID the
# storefront uses; see backend/.env.example and its README section on
# Google Sign-In for how to get this free from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
