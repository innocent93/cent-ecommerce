# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database ---------------------------------------------------------------
# Local docker-compose mongo:       mongodb://mongo:27017/ecommerce
# MongoDB Atlas:                    mongodb+srv://<user>:<pass>@<cluster>/ecommerce
MONGO_URI=mongodb://mongo:27017/ecommerce

# --- Auth / session management ----------------------------------------------
# Generate a strong random secret, e.g.: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_string

# Access tokens are short-lived on purpose (this app moves money). The
# refresh token (stored server-side, httpOnly cookie + returned in the
# response body for native/Flutter clients) is what keeps users logged in
# without needing a long-lived access token.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=4h

# Used once, on first server boot, to create the initial superadmin
# account in the database (see user.service.js#seedSuperAdmin). After that,
# manage staff accounts (support/admin/superadmin) from the admin panel's
# Staff page instead of editing these — changing them later does NOT change
# an already-created superadmin's password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Account lockout after repeated failed logins (brute-force protection).
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Domain for the refresh-token cookie in production, e.g. ".yourshop.com"
# (leading dot shares it across subdomains). Leave empty for localhost dev.
COOKIE_DOMAIN=

# --- Cloudinary (image storage) ---------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed browser origins (React storefront/admin).
# Native apps (Flutter/iOS/Android) are not restricted by CORS.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Misc ---------------------------------------------------------------
BODY_LIMIT=2mb

# --- Global commerce ---------------------------------------------------------
# Currency all product prices are stored/entered in. Defaults to NGN since
# this launches Nigeria/Africa-first — change to USD/EUR/etc. when you
# expand and re-price products in that market's currency, or just keep NGN
# as the base and let the currency converter handle display conversion.
BASE_CURRENCY=NGN

# Optional: enables live exchange rates (https://www.exchangerate-api.com,
# free tier available). Without this, a static fallback rate table is used —
# fine for development, but set this (or update the fallback table) before
# going live so displayed prices don't drift from real rates.
EXCHANGE_RATE_API_KEY=

# --- Paystack (primary payment rail — cards, bank transfer, USSD, mobile
# money across Nigeria & most of Africa) --------------------------------
# Get these from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
# Use the sk_test_/pk_test_ keys until you're ready to go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Public URL of the storefront, used to build the Paystack post-payment
# redirect (?reference=... appended automatically).
FRONTEND_URL=http://localhost:5173

# What the platform keeps per order, as a decimal (0.1 = 10%). See
# BUSINESS_MODEL.md for how this is used — it's how the store owner
# actually makes money if this becomes a multi-vendor marketplace, and is
# also useful as a simple revenue/margin figure even for a single-seller
# store.
COMMISSION_RATE=0.1

# Optional: comma-separated ISO country codes you currently ship to
# (e.g. "NG,GH,KE,ZA"). Leave empty to allow all countries.
SHIPPING_COUNTRIES=NG,GH,KE,ZA

# --- Transactional email (welcome, order confirmation, payment confirmation,
# shipping updates, password reset, refunds, admin new-order alerts) --------
# Resend HTTP API (recommended for Render and other managed hosts)
RESEND_API_KEY=
EMAIL_FROM_NAME=UrbanStep
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
# Where new-order admin notifications go.
ADMIN_NOTIFY_EMAIL=

# --- SMS (order confirmation, shipping, delivery, refund notifications) ----
# Not wired to a live provider by default — sms.service.js has a
# ready-to-fill Termii example. Get SMS_API_KEY from your provider
# (Termii/Africa's Talking recommended for Nigeria) and set it here; every
# call site starts working automatically once this is set.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Redis (caching + shared rate limiting across instances) ---------------
# Required once you run more than one backend instance (horizontal
# scaling) — without it, rate limits and cached data are per-process, not
# shared. Optional for a single-instance/local dev setup (everything
# degrades gracefully to in-memory/no-op). See SCALING.md.
# Docker Compose: redis://redis:6379
# Managed (e.g. Upstash, Redis Cloud, AWS ElastiCache): the URL they give you
REDIS_URL=
CACHE_TTL_SECONDS=60

# --- Google Sign-In (optional, free) ----------------------------------------
# Get this free from Google Cloud Console — see the README's "Google Login"
# section for exact steps. Leave empty to disable (the frontend button just
# won't render).
GOOGLE_CLIENT_ID=

# --- Error tracking (optional, recommended for production) ------------------
# Free tier available at sentry.io. Leave blank and the app runs exactly the
# same — errors just stay in structured logs only (see LOG_LEVEL above),
# with no external alerting/aggregation on top.
SENTRY_DSN=
